{
  "name": "@cyvest/cyvest-js",
  "version": "7.0.0",
  "description": "Typed reader for Cyvest investigation documents: schema validation, fact accessors, and graph helpers.",
  "keywords": [
    "cybersecurity",
    "investigation",
    "threat-intel",
    "security-analysis",
    "cyvest"
  ],
  "homepage": "https://github.com/PakitoSec/cyvest#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PakitoSec/cyvest.git",
    "directory": "js/packages/cyvest-js"
  },
  "bugs": {
    "url": "https://github.com/PakitoSec/cyvest/issues"
  },
  "license": "MIT",
  "author": "PakitoSec",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "generate:types": "node ../../tools/generate_ts_types.mjs",
    "test": "vitest",
    "test:ci": "vitest run --reporter=dot"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "json-schema-to-typescript": "^15.0.4",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "unrun": "^0.3.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
