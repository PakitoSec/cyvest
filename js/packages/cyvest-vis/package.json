{
  "name": "@cyvest/cyvest-vis",
  "version": "7.0.0",
  "description": "React components to explore a Cyvest investigation as an interactive observable graph.",
  "keywords": [
    "cybersecurity",
    "investigation",
    "graph",
    "visualization",
    "react",
    "cyvest"
  ],
  "homepage": "https://github.com/PakitoSec/cyvest#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PakitoSec/cyvest.git",
    "directory": "js/packages/cyvest-vis"
  },
  "bugs": {
    "url": "https://github.com/PakitoSec/cyvest/issues"
  },
  "license": "MIT",
  "author": "PakitoSec",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --dts --format cjs,esm --external react --external react-dom && cp src/styles.css dist/styles.css",
    "test": "vitest",
    "test:ci": "vitest run --reporter=dot"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@cyvest/cyvest-js": "workspace:*",
    "cytoscape": "^3.34.0",
    "d3-force": "^3.0.0"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22"
  }
}
