            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight"
        },
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "seq": {
          "maxLength": 26,
          "minLength": 26,
          "title": "Seq",
          "type": "string"
        },
