          "minLength": 1,
          "title": "Source Key",
          "type": "string"
        },
        "target_key": {
          "minLength": 1,
          "title": "Target Key",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/RelationKind",
          "default": "related-to"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        },
        "confidence": {
          "default": 1.0,
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Confidence",
          "type": "number"
        },
        "comment": {
          "default": "",
          "title": "Comment",
          "type": "string"
        }
      },
      "required": [
        "key",
        "seq",
        "asserted_at",
        "source",
        "fragment_id",
        "source_key",
        "target_key"
      ],
      "title": "Relation",
      "type": "object"
    },
    "RelationKind": {
      "description": "The analyst pivot that produced the target from the source.\n\nDirection is implied: ``source_key`` is the parent, ``target_key`` the child. ``RELATED_TO``\nis symmetric and excluded from propagation, which makes v6's ``EXTRACTION`` +\n``BIDIRECTIONAL`` combination inexpressible.",
      "enum": [
        "extraction",
        "pivot",
        "related-to"
      ],
      "title": "RelationKind",
      "type": "string"
    },
    "Report": {
      "description": "A full evaluation. Derived, never stored on the facts, recomputed from them.",
      "properties": {
        "engine_id": {
          "title": "Engine Id",
          "type": "string"
        },
        "policy_version": {
          "title": "Policy Version",
          "type": "string"
        },
        "investigation": {
          "$ref": "#/$defs/InvestigationResult"
        },
        "findings": {
          "additionalProperties": {
            "$ref": "#/$defs/FindingResult"
          },
          "title": "Findings",
          "type": "object"
        },
        "observables": {
          "additionalProperties": {
            "$ref": "#/$defs/ObservableResult"
          },
          "title": "Observables",
          "type": "object"
        }
      },
      "required": [
        "engine_id",
        "policy_version",
        "investigation"
      ],
      "title": "Report",
      "type": "object"
    },
    "ResolvedScope": {
      "description": "A link scope with ``OWN_FRAGMENT`` already resolved to the fragment that carries the link.\n\n``OWN_FRAGMENT`` is not *one* scope: it denotes a different set of facts for every fragment.\nTwo findings from different fragments pointing at the same observable need two distinct\nresults, so results are indexed by the resolved scope — never by the raw label.\n\nA model rather than a tuple so it crosses the JSON boundary as a named object: the report is\nthe contract a front-end reads, and positional data makes for a poor contract.",
      "properties": {
        "scope": {
          "$ref": "#/$defs/Scope",
          "default": "ALL"
        },
        "fragment_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fragment Id"
        }
      },
      "title": "ResolvedScope",
      "type": "object"
    },
    "Scope": {
      "description": "How far a Finding→Observable link looks when evaluating its observable.\n\nReplaces v6's ``PropagationMode`` one-for-one. ``OWN_FRAGMENT`` resolves to *the fragment of\nthe finding that carries the link*, so it denotes a different scope for each fragment — the\nreport indexes observable results by the resolved scope, never by this label.",
      "enum": [
        "OWN_FRAGMENT",
        "ALL"
      ],
      "title": "Scope",
      "type": "string"
    },
    "SourceClass": {
      "description": "Family a source belongs to, used by the policy to weigh its reliability.",
      "enum": [
        "vendor_feed",
        "sandbox",
        "osint",
        "internal_tool",
        "org_analyst",
        "org_policy",
        "unknown"
      ],
      "title": "SourceClass",
      "type": "string"
    },
    "SourceRef": {
      "description": "Who or what asserted a fact.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "source_class": {
          "$ref": "#/$defs/SourceClass",
          "default": "unknown"
        }
      },
      "required": [
        "name"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "Status": {
      "description": "Whether a finding takes part in the evaluation at all.\n\nAnything other than ``EVALUATED`` is excluded from the score *and* from aggregation\ndenominators, while staying visible in the report.",
      "enum": [
        "NOT_APPLICABLE",
        "PENDING",
        "EVALUATED"
      ],
      "title": "Status",
      "type": "string"
    },
    "Tag": {
      "additionalProperties": false,
      "description": "A label grouping findings. Merging two tags unions their finding keys.",
      "properties": {
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "seq": {
          "maxLength": 26,
          "minLength": 26,
          "title": "Seq",
          "type": "string"
        },
        "asserted_at": {
          "format": "date-time",
          "title": "Asserted At",
          "type": "string"
        },
        "occurred_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occurred At"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "fragment_id": {
          "title": "Fragment Id",
          "type": "string"
        },
        "external_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Id"
        },
        "evidence_keys": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Keys",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "finding_keys": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Finding Keys",
          "type": "array"
        }
      },
      "required": [
        "key",
        "seq",
        "asserted_at",
        "source",
        "fragment_id",
        "name"
      ],
      "title": "Tag",
      "type": "object"
    },
    "ThreatIntel": {
      "additionalProperties": false,
      "description": "A verdict from a threat-intelligence source.\n\nIdentity is ``(source, subject_key)`` — byte-identical to v6 — so a source re-asserting the\nsame observable updates in place instead of piling up duplicates. Pass ``external_id`` to\nkeep history on purpose.",
      "properties": {
        "subject_key": {
          "minLength": 1,
          "title": "Subject Key",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict",
          "default": "INFO"
        },
        "confidence": {
          "default": 1.0,
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Confidence",
          "type": "number"
        },
        "weight": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight"
        },
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "seq": {
          "maxLength": 26,
          "minLength": 26,
          "title": "Seq",
          "type": "string"
        },
        "asserted_at": {
          "format": "date-time",
          "title": "Asserted At",
          "type": "string"
        },
        "occurred_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occurred At"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "fragment_id": {
          "title": "Fragment Id",
          "type": "string"
        },
        "external_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Id"
        },
        "evidence_keys": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Keys",
          "type": "array"
        },
        "kind": {
          "const": "threat_intel",
          "default": "threat_intel",
          "title": "Kind",
          "type": "string"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        },
        "labels": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Label"
          },
          "title": "Labels",
          "type": "array"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "source_class": {
          "$ref": "#/$defs/SourceClass",
          "default": "vendor_feed"
        },
        "taxonomies": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Taxonomies",
          "type": "array"
        },
        "comment": {
          "default": "",
          "title": "Comment",
          "type": "string"
        }
      },
      "required": [
        "subject_key",
        "key",
        "seq",
        "asserted_at",
        "source",
        "fragment_id"
      ],
      "title": "ThreatIntel",
      "type": "object"
    },
    "Verdict": {
      "description": "Direction of a judgment, and the displayed level — they are the same thing.\n\nv7 merges the former ``Level`` into ``Verdict``. The five values line up one-for-one with\nthe score bands ``basic-v1`` inherits from v6 (``< 0``, ``= 0``, ``]0,3[``, ``[3,5[``,\n``>= 5``), which makes a verdict/level divergence structurally impossible.\n\nThose bands are ``basic-v1``'s convention, **not** part of the enum's contract: a\nprobabilistic engine maps its own posterior thresholds onto the same labels.\n\nTwo v6 levels deliberately left this axis: ``NONE`` became :class:`Status` and ``TRUSTED``\nbecame a :class:`DecisionKind` (or plain ``SAFE`` when it was merely a negative score).",
      "enum": [
        "SAFE",
        "INFO",
        "NOTABLE",
        "SUSPICIOUS",
        "MALICIOUS"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "$id": "https://cyvest.io/schema/investigation-7.json",
  "additionalProperties": false,
  "description": "A complete serialized investigation.",
  "properties": {
    "schema_version": {
      "default": "7.0.0",
      "pattern": "^7\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "header": {
      "$ref": "#/$defs/InvestigationHeader"
    },
    "policy_version": {
      "default": "default-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "engine_id": {
      "default": "basic-v1",
      "title": "Engine Id",
      "type": "string"
    },
    "facts": {
      "$ref": "#/$defs/FactsSchema"
    },
    "decisions": {
      "additionalProperties": {
        "$ref": "#/$defs/Decision"
      },
      "title": "Decisions",
      "type": "object"
    },
    "tags": {
      "additionalProperties": {
        "$ref": "#/$defs/Tag"
      },
      "title": "Tags",
      "type": "object"
    },
    "report": {
      "$ref": "#/$defs/Report"
    }
  },
  "required": [
    "header",
    "report"
  ],
  "title": "InvestigationSchema",
  "type": "object"
}
