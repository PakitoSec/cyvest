{
  "$defs": {
    "DataExtractionSchema": {
      "additionalProperties": false,
      "description": "Schema for data extraction metadata.",
      "properties": {
        "root_type": {
          "anyOf": [
            {
              "enum": [
                "file",
                "artifact"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Root observable type used during data extraction.",
          "title": "Root Type"
        },
        "score_mode_obs": {
          "$ref": "#/$defs/ScoreMode",
          "description": "Observable score aggregation mode: 'max' takes highest score, 'sum' adds all scores."
        }
      },
      "required": [
        "score_mode_obs"
      ],
      "title": "DataExtractionSchema",
      "type": "object"
    },
    "Enrichment": {
      "description": "Represents structured data enrichment for the investigation.\n\nEnrichments store arbitrary structured data that provides additional\ncontext but doesn't directly contribute to scoring.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "data": {
          "title": "Data"
        },
        "context": {
          "title": "Context",
          "type": "string"
        },
        "key": {
          "title": "Key",
          "type": "string"
        }
      },
      "required": [
        "name",
        "data",
        "context",
        "key"
      ],
      "title": "Enrichment",
      "type": "object"
    },
    "Evidence": {
      "description": "Structured material supporting one or more findings.",
      "properties": {
        "type": {
          "title": "Type",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "external_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "External Id"
        },
        "content": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "title": "Content"
        },
        "uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Uri"
        },
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "extra": {
          "additionalProperties": true,
          "title": "Extra",
          "type": "object"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "finding_links": {
          "description": "Findings that currently link to this evidence (navigation-only).",
          "items": {
            "type": "string"
          },
          "readOnly": true,
          "title": "Finding Links",
          "type": "array"
        }
      },
      "required": [
        "type",
        "title",
        "description",
        "source",
        "external_id",
        "content",
        "uri",
        "captured_at",
        "extra",
        "key",
        "finding_links"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceLink": {
      "additionalProperties": false,
      "description": "Edge metadata for a Finding\u2194Evidence association.",
      "properties": {
        "evidence_key": {
          "title": "Evidence Key",
          "type": "string"
        }
      },
      "required": [
        "evidence_key"
      ],
      "title": "EvidenceLink",
      "type": "object"
    },
    "Finding": {
      "description": "Represents a verification step in the investigation.\n\nA finding validates a specific aspect of the data under investigation\nand contributes to the overall investigation score.",
      "properties": {
        "finding_name": {
          "title": "Finding Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "comment": {
          "title": "Comment",
          "type": "string"
        },
        "extra": {
          "additionalProperties": true,
          "title": "Extra",
          "type": "object"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "level": {
          "$ref": "#/$defs/Level"
        },
        "origin_investigation_id": {
          "title": "Origin Investigation Id",
          "type": "string"
        },
        "observable_links": {
          "items": {
            "$ref": "#/$defs/ObservableLink"
          },
          "title": "Observable Links",
          "type": "array"
        },
        "evidence_links": {
          "items": {
            "$ref": "#/$defs/EvidenceLink"
          },
          "title": "Evidence Links",
          "type": "array"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "score_display": {
          "readOnly": true,
          "title": "Score Display",
          "type": "string"
        }
      },
      "required": [
        "finding_name",
        "description",
        "comment",
        "extra",
        "score",
        "level",
        "origin_investigation_id",
        "observable_links",
        "evidence_links",
        "key",
        "score_display"
      ],
      "title": "Finding",
      "type": "object"
    },
    "InvestigationWhitelist": {
      "description": "Represents a whitelist entry on an investigation.",
      "properties": {
        "identifier": {
          "minLength": 1,
          "title": "Identifier",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "justification": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Justification"
        }
      },
      "required": [
        "identifier",
        "name"
      ],
      "title": "InvestigationWhitelist",
      "type": "object"
    },
    "Level": {
      "description": "Security level classification for findings, observables, and threat intelligence.\n\nLevels are ordered from lowest (NONE) to highest (MALICIOUS) severity.",
      "enum": [
        "NONE",
        "TRUSTED",
        "INFO",
        "SAFE",
        "NOTABLE",
        "SUSPICIOUS",
        "MALICIOUS"
      ],
      "title": "Level",
      "type": "string"
    },
    "Observable": {
      "description": "Represents a cyber observable (IP, URL, domain, hash, etc.).\n\nObservables can be linked to threat intelligence, findings, and other observables\nthrough relationships.",
      "properties": {
        "type": {
          "title": "Type",
          "type": "string"
        },
        "subtype": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Subtype"
        },
        "namespace": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Namespace"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "internal": {
          "title": "Internal",
          "type": "boolean"
        },
        "whitelisted": {
          "title": "Whitelisted",
          "type": "boolean"
        },
        "comment": {
          "title": "Comment",
          "type": "string"
        },
        "extra": {
          "additionalProperties": true,
          "title": "Extra",
          "type": "object"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "level": {
          "$ref": "#/$defs/Level"
        },
        "aliases": {
          "items": {
            "$ref": "#/$defs/ObservableAlias"
          },
          "title": "Aliases",
          "type": "array"
        },
        "occurrence_count": {
          "default": 1,
          "minimum": 1,
          "title": "Occurrence Count",
          "type": "integer"
        },
        "threat_intels": {
          "items": {
            "type": "string"
          },
          "title": "Threat Intels",
          "type": "array"
        },
        "relationships": {
          "items": {
            "$ref": "#/$defs/Relationship"
          },
          "title": "Relationships",
          "type": "array"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "finding_links": {
          "description": "Findings that currently link to this observable (navigation-only).",
          "items": {
            "type": "string"
          },
          "readOnly": true,
          "title": "Finding Links",
          "type": "array"
        },
        "score_display": {
          "readOnly": true,
          "title": "Score Display",
          "type": "string"
        }
      },
      "required": [
        "type",
        "value",
        "internal",
        "whitelisted",
        "comment",
        "extra",
        "score",
        "level",
        "threat_intels",
        "relationships",
        "key",
        "finding_links",
        "score_display"
      ],
      "title": "Observable",
      "type": "object"
    },
    "ObservableAlias": {
      "description": "Source observable identity attached to a canonical observable.",
      "properties": {
        "type": {
          "title": "Type",
          "type": "string"
        },
        "subtype": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Subtype"
        },
        "namespace": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Namespace"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "count": {
          "default": 1,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "ObservableAlias",
      "type": "object"
    },
    "ObservableLink": {
      "additionalProperties": false,
      "description": "Edge metadata for a Finding\u2194Observable association.",
      "properties": {
        "observable_key": {
          "title": "Observable Key",
          "type": "string"
        },
        "propagation_mode": {
          "$ref": "#/$defs/PropagationMode",
          "default": "LOCAL_ONLY"
        }
      },
      "required": [
        "observable_key"
      ],
      "title": "ObservableLink",
      "type": "object"
    },
    "PropagationMode": {
      "description": "Controls how a Finding\u2194Observable link propagates across merged investigations.",
      "enum": [
        "LOCAL_ONLY",
        "GLOBAL"
      ],
      "title": "PropagationMode",
      "type": "string"
    },
    "Relationship": {
      "description": "Represents a relationship between observables.",
      "properties": {
        "target_key": {
          "title": "Target Key",
          "type": "string"
        },
        "relationship_type": {
          "title": "Relationship Type",
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/RelationshipDirection"
        }
      },
      "required": [
        "target_key",
        "relationship_type",
        "direction"
      ],
      "title": "Relationship",
      "type": "object"
    },
    "RelationshipDirection": {
      "description": "Direction of a relationship between observables.",
      "enum": [
        "outbound",
        "inbound",
        "bidirectional"
      ],
      "title": "RelationshipDirection",
      "type": "string"
    },
    "ScoreMode": {
      "description": "Score calculation mode for observables.",
      "enum": [
        "max",
        "sum"
      ],
      "title": "ScoreMode",
      "type": "string"
    },
    "StatisticsSchema": {
      "additionalProperties": false,
      "description": "Schema for investigation statistics.\n\nMirrors the output of `InvestigationStats.get_summary()`.",
      "properties": {
        "total_observables": {
          "minimum": 0,
          "title": "Total Observables",
          "type": "integer"
        },
        "internal_observables": {
          "minimum": 0,
          "title": "Internal Observables",
          "type": "integer"
        },
        "external_observables": {
          "minimum": 0,
          "title": "External Observables",
          "type": "integer"
        },
        "whitelisted_observables": {
          "minimum": 0,
          "title": "Whitelisted Observables",
          "type": "integer"
        },
        "observables_by_type": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Observables By Type",
          "type": "object"
        },
        "observables_by_level": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Observables By Level",
          "type": "object"
        },
        "observables_by_type_and_level": {
          "additionalProperties": {
            "additionalProperties": {
              "minimum": 0,
              "type": "integer"
            },
            "type": "object"
          },
          "title": "Observables By Type And Level",
          "type": "object"
        },
        "total_findings": {
          "minimum": 0,
          "title": "Total Findings",
          "type": "integer"
        },
        "applied_findings": {
          "minimum": 0,
          "title": "Applied Findings",
          "type": "integer"
        },
        "findings_by_level": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Findings By Level",
          "type": "object"
        },
        "total_evidences": {
          "minimum": 0,
          "title": "Total Evidences",
          "type": "integer"
        },
        "evidences_by_type": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Evidences By Type",
          "type": "object"
        },
        "evidences_by_source": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Evidences By Source",
          "type": "object"
        },
        "total_threat_intel": {
          "minimum": 0,
          "title": "Total Threat Intel",
          "type": "integer"
        },
        "threat_intel_by_source": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Threat Intel By Source",
          "type": "object"
        },
        "threat_intel_by_level": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Threat Intel By Level",
          "type": "object"
        },
        "total_tags": {
          "minimum": 0,
          "title": "Total Tags",
          "type": "integer"
        }
      },
      "required": [
        "total_observables",
        "internal_observables",
        "external_observables",
        "whitelisted_observables",
        "total_findings",
        "applied_findings",
        "total_evidences",
        "total_threat_intel",
        "total_tags"
      ],
      "title": "StatisticsSchema",
      "type": "object"
    },
    "Tag": {
      "additionalProperties": false,
      "description": "Groups findings for categorical organization.\n\nTags allow structuring the investigation into logical sections\nwith aggregated scores and levels. Hierarchy is automatic based on\nthe \":\" delimiter in tag names (e.g., \"header:auth:dkim\").",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "findings": {
          "items": {
            "type": "string"
          },
          "title": "Findings",
          "type": "array"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "direct_score": {
          "description": "Calculate the score from direct findings only (no hierarchy).\n\nFor hierarchical aggregation (including descendant tags), use\nInvestigation.get_tag_aggregated_score() or TagProxy.get_aggregated_score().\n\nReturns:\n    Total score from direct findings",
          "readOnly": true,
          "title": "Direct Score",
          "type": "number"
        },
        "direct_level": {
          "$ref": "#/$defs/Level",
          "description": "Calculate the level from direct findings only (no hierarchy).\n\nFor hierarchical aggregation (including descendant tags), use\nInvestigation.get_tag_aggregated_level() or TagProxy.get_aggregated_level().\n\nReturns:\n    Level based on direct score",
          "readOnly": true
        }
      },
      "required": [
        "name",
        "findings",
        "key",
        "direct_score",
        "direct_level"
      ],
      "title": "Tag",
      "type": "object"
    },
    "Taxonomy": {
      "additionalProperties": false,
      "description": "Represents a structured taxonomy entry for threat intelligence.",
      "properties": {
        "level": {
          "$ref": "#/$defs/Level"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "level",
        "name",
        "value"
      ],
      "title": "Taxonomy",
      "type": "object"
    },
    "ThreatIntel": {
      "description": "Represents threat intelligence from an external source.\n\nThreat intelligence provides verdicts about observables from sources\nlike VirusTotal, URLScan.io, etc.",
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "observable_key": {
          "title": "Observable Key",
          "type": "string"
        },
        "comment": {
          "title": "Comment",
          "type": "string"
        },
        "extra": {
          "additionalProperties": true,
          "title": "Extra",
          "type": "object"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "level": {
          "$ref": "#/$defs/Level"
        },
        "taxonomies": {
          "items": {
            "$ref": "#/$defs/Taxonomy"
          },
          "title": "Taxonomies",
          "type": "array"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "score_display": {
          "readOnly": true,
          "title": "Score Display",
          "type": "string"
        }
      },
      "required": [
        "source",
        "observable_key",
        "comment",
        "extra",
        "score",
        "level",
        "taxonomies",
        "key",
        "score_display"
      ],
      "title": "ThreatIntel",
      "type": "object"
    }
  },
  "$id": "https://cyvest.io/schema/investigation.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Schema for a complete serialized investigation.\n\nThis model describes the output of `serialize_investigation()` from\n`cyvest.io_serialization`. It is the top-level schema for exported investigations.\n\nEntity types reference the runtime models directly. When generating schemas with\n`mode='serialization'`, Pydantic respects field_serializer decorators and produces\nschemas matching the actual model_dump() output.",
  "properties": {
    "schema_version": {
      "const": "6.0.0",
      "default": "6.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "investigation_id": {
      "description": "Stable investigation identity (ULID).",
      "title": "Investigation Id",
      "type": "string"
    },
    "investigation_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional human-readable investigation name.",
      "title": "Investigation Name"
    },
    "score": {
      "description": "Global investigation score.",
      "title": "Score",
      "type": "number"
    },
    "level": {
      "$ref": "#/$defs/Level",
      "description": "Security level classification from NONE (lowest) to MALICIOUS (highest)."
    },
    "whitelisted": {
      "description": "Whether the investigation is whitelisted.",
      "title": "Whitelisted",
      "type": "boolean"
    },
    "whitelists": {
      "description": "List of whitelist entries applied to this investigation.",
      "items": {
        "$ref": "#/$defs/InvestigationWhitelist"
      },
      "title": "Whitelists",
      "type": "array"
    },
    "observables": {
      "additionalProperties": {
        "$ref": "#/$defs/Observable"
      },
      "description": "Observables keyed by their unique key.",
      "title": "Observables",
      "type": "object"
    },
    "findings": {
      "additionalProperties": {
        "$ref": "#/$defs/Finding"
      },
      "description": "Findings keyed by their unique key.",
      "title": "Findings",
      "type": "object"
    },
    "evidences": {
      "additionalProperties": {
        "$ref": "#/$defs/Evidence"
      },
      "description": "Evidence objects keyed by their unique key.",
      "title": "Evidences",
      "type": "object"
    },
    "threat_intels": {
      "additionalProperties": {
        "$ref": "#/$defs/ThreatIntel"
      },
      "description": "Threat intelligence entries keyed by their unique key.",
      "title": "Threat Intels",
      "type": "object"
    },
    "enrichments": {
      "additionalProperties": {
        "$ref": "#/$defs/Enrichment"
      },
      "description": "Enrichment entries keyed by their unique key.",
      "title": "Enrichments",
      "type": "object"
    },
    "tags": {
      "additionalProperties": {
        "$ref": "#/$defs/Tag"
      },
      "description": "Tags keyed by their unique key.",
      "title": "Tags",
      "type": "object"
    },
    "stats": {
      "$ref": "#/$defs/StatisticsSchema",
      "description": "Investigation statistics summary."
    },
    "data_extraction": {
      "$ref": "#/$defs/DataExtractionSchema",
      "description": "Data extraction metadata."
    },
    "score_display": {
      "description": "Global investigation score formatted as fixed-point x.xx.",
      "readOnly": true,
      "title": "Score Display",
      "type": "string"
    }
  },
  "required": [
    "investigation_id",
    "score",
    "level",
    "whitelisted",
    "whitelists",
    "observables",
    "findings",
    "evidences",
    "threat_intels",
    "enrichments",
    "tags",
    "stats",
    "data_extraction",
    "score_display"
  ],
  "title": "Cyvest Investigation",
  "type": "object"
}
